# =============================================================================
# ONE CONTROL — variáveis de ambiente (NUNCA commitar valores reais)
# Copie para .env.local em desenvolvimento. Em produção/homologação configure
# no painel da Vercel (Settings → Environment Variables), por ambiente.
# =============================================================================

# Ambiente: development | staging | production
APP_ENV=development

# URL pública da aplicação (usada em links de convite e recuperação de senha).
APP_URL=http://localhost:3000

# --- Supabase (Project Settings → API) ---------------------------------------
# Públicas por design (protegidas por RLS). Use a chave "publishable" (sb_publishable_...).
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# SECRETA — somente servidor. Chave "secret" (sb_secret_...) ou service_role legada.
# Usada apenas para: convites (auth.admin), Storage após autorização, integração
# Google Forms e rotina diária. Nunca prefixar com NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# --- Integração Google Forms -------------------------------------------------
# Segredo HMAC-SHA256 compartilhado com o Apps Script (>= 32 caracteres aleatórios).
# Gerar: openssl rand -hex 32
GOOGLE_FORMS_WEBHOOK_SECRET=

# --- Rotina diária (Vercel Cron) ---------------------------------------------
# A Vercel envia "Authorization: Bearer $CRON_SECRET" (>= 32 caracteres).
CRON_SECRET=

# --- Notificações push (Web Push / VAPID) — opcional ---------------------------
# Sem estas três variáveis o push fica desativado (a central de notificações continua).
# Gerar UMA vez por ambiente: npx web-push generate-vapid-keys
# A chave pública vai ao navegador por design; a PRIVADA é somente servidor.
# Trocar o par invalida as inscrições existentes (cada pessoa reativa no aparelho).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contato@seudominio.com.br

# --- Testes E2E autenticados (somente HOMOLOGAÇÃO, nunca produção) ------------
# E2E_BASE_URL=https://one-control-homolog.vercel.app
# E2E_SELLER_A_EMAIL=
# E2E_SELLER_A_PASSWORD=
# E2E_ADMIN_EMAIL=
# E2E_ADMIN_PASSWORD=
# E2E_ADMIN_TOTP_SECRET=
# E2E_FOREIGN_CLIENT_ID=
